      {
        "icon": "code",
        "title": "防盗链",
        "desc": "referer / origin 白名单可配，非法来源直接 403。"
      },
      {
        "icon": "desktop",
        "title": "容器化部署",
        "desc": "Docker Compose 一行起服务，uv 管依赖，冷启动 0.3 秒。"
